CURSOR_API_KEY=
WEBFLOW_MCP_URL=https://mcp.webflow.com/mcp

# Optional: site/workspace token from the Webflow API Playground
# WEBFLOW_TOKEN=

# Webflow Data Client OAuth app
# WEBFLOW_CLIENT_ID=
# WEBFLOW_CLIENT_SECRET=
# Optional override. If unset, Flowmind uses the current app URL automatically.
# WEBFLOW_REDIRECT_URI=https://your-app.vercel.app/api/webflow/callback
# Optional comma-separated scopes. Must match scopes enabled on your Webflow app.
# WEBFLOW_OAUTH_SCOPES=authorized_user:read sites:read sites:write pages:read pages:write

# On Vercel, the agent runs in Cursor Cloud automatically (no local process needed).
# Locally, it uses stdio MCP servers via npx.

# CURSOR_MODEL=composer-2.5
# AGENT_TIMEOUT_MS=180000
