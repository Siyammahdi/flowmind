CURSOR_API_KEY=
WEBFLOW_MCP_URL=https://mcp.webflow.com/mcp

# Optional: site/workspace token from the Webflow API Playground
# WEBFLOW_TOKEN=

# Optional: Webflow Data Client OAuth app (lets any Webflow account connect in the UI)
# WEBFLOW_CLIENT_ID=
# WEBFLOW_CLIENT_SECRET=
# WEBFLOW_REDIRECT_URI=http://localhost:3000/api/webflow/callback

# http = remote MCP with bearer token; stdio = official webflow-mcp-server
# WEBFLOW_MCP_TRANSPORT=stdio

# CURSOR_MODEL=composer-2.5
# AGENT_TIMEOUT_MS=180000
